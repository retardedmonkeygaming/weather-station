# .env example — created & managed by the first-run setup wizard
# Copy to .env and adjust, or just run `python main.py` and follow the wizard.

# --- LCD pin map (BCM numbering, 4-bit mode) ---
LCD_RS=22
LCD_EN=17
LCD_D4=25
LCD_D5=24
LCD_D6=23
LCD_D7=18

# --- Sensors & actuators ---
DHT_PIN=4
BUTTON_PIN=27
BUZZER_PIN=2

# --- Integrations (optional) ---
# Discord bot token from https://discord.com/developers/applications
# DISCORD_BOT_TOKEN=
# Live-update channel: weather cards posted on data change
# DISCORD_UPDATE_CHANNEL_ID=123456789012345678
# DISCORD_UPDATE_MIN_INTERVAL_S=60
# Role allowed to use admin commands (admins always pass)
# DISCORD_ADMIN_ROLE=Station Admin

# --- Optional LCD contrast PWM (Guest Mode dimming) ---
# Wire the 1602A V0 pin through an RC filter to this BCM pin.
# Without it, Guest Mode dims via backlight instead.
# LCD_CONTRAST_PIN=13

# --- MQTT publishing (optional) ---
# Set MQTT_BROKER to enable; test with: POST /api/mqtt/publish
# MQTT_BROKER=192.168.1.50
# MQTT_PORT=1883
# MQTT_TOPIC=weatherstation
# MQTT_INTERVAL_S=60

# --- Server overrides (optional) ---
# WEATHER_HOST=0.0.0.0
# WEATHER_PORT=8000
# WEATHER_DB_PATH=./weather_history.db
